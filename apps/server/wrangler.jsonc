{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "color-dice",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-17",
  // workers_dev: true makes deploy turn on the color-dice.<subdomain>.workers.dev URL.
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "GAME_ROOM", "class_name": "GameRoom" },
      { "name": "LOBBY", "class_name": "Lobby" },
      { "name": "RATE_LIMITER", "class_name": "RateLimiter" }
    ]
  },
  // new_sqlite_classes is required on the Free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom", "Lobby", "RateLimiter"] }],
  // Prod vars only. Local origins, ALLOW_TEST_HOOKS and PBKDF2_ITERATIONS live in the
  // git-ignored .dev.vars (see .dev.vars.example); scripts/check-wrangler.mjs enforces this.
  "vars": {
    "ALLOWED_ORIGINS": "https://andrewdrury.github.io"
  }
}
