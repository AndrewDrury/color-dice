{
  "name": "color-dice",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "e2e"
  ],
  "scripts": {
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "lint:nohtml": "node scripts/no-inner-html.mjs",
    "lint:i18n": "node scripts/check-i18n.mjs",
    "test": "npm run test --workspaces --if-present",
    "lint:secrets": "node scripts/secret-scan.mjs",
    "lint:secrets:dist": "node scripts/secret-scan.mjs --dist",
    "lint:wrangler": "node scripts/check-wrangler.mjs",
    "lint:secrets:history": "node scripts/secret-scan.mjs --history",
    "check": "npm run typecheck && npm run lint && npm run lint:nohtml && npm run lint:i18n && npm run lint:wrangler && npm run test && npm run lint:secrets",
    "dev:server": "npm run dev -w apps/server",
    "dev:client": "npm run dev -w apps/client",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "build": "npm run build -w apps/client"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
